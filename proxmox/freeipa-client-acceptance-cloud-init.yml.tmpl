#cloud-config
output: {all: '| tee -a /var/log/cloud-init-output.log /dev/ttyS0'}
fqdn: ${VM_FQDN}
manage_etc_hosts: true

write_files:
  - path: /usr/local/sbin/configure-puppet-acceptance
    permissions: '0755'
    content: |
      #!/bin/bash
      set -euo pipefail
      mkdir -p /etc/puppetlabs/puppet /etc/facter/facts.d
      cat > /etc/puppetlabs/puppet/csr_attributes.yaml <<EOF
      custom_attributes:
        1.2.840.113549.1.9.7: "${VM_TOKEN}"
      EOF
      chmod 0640 /etc/puppetlabs/puppet/csr_attributes.yaml
      echo 'node_type=${NODE_TYPE}' > /etc/facter/facts.d/node_type.txt
      /opt/puppetlabs/bin/puppet config set server '${PUPPET_SERVER}' --section main
      /opt/puppetlabs/bin/puppet config set certificate_revocation leaf --section agent
      systemctl enable puppet
      # The acceptance runner performs the authoritative Puppet run after
      # cloud-init.  Do not discard the VM's diagnostics if this bootstrap
      # catalog is temporarily unavailable.
      /opt/puppetlabs/bin/puppet agent --test --waitforlock 300 || true

runcmd:
  - wget -q -O /tmp/puppet.deb https://apt-puppetcore.puppet.com/public/puppet8-release-noble.deb
  - dpkg -i /tmp/puppet.deb
  - rm /tmp/puppet.deb
  - apt-get update
  - apt-get install -y puppet-agent
  # The package may start Puppet before its autosign token and node fact are
  # configured. Stop it so the configuration script performs the sole first
  # agent run.
  - systemctl disable --now puppet
  - /usr/local/sbin/configure-puppet-acceptance
