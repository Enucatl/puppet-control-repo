#cloud-config
output: {all: '| tee -a /var/log/cloud-init-output.log /dev/ttyS0'}
bootcmd:
  - cloud-init-per instance puppet-enrollment-mask systemctl mask --runtime --now puppet.service
users:
  - name: user_l
    groups: sudo, docker
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
      - ${SSH_PUBLIC_KEY_JSON}

write_files:
  - path: /usr/local/bin/install-openvox.sh
    permissions: '0755'
    content: |
${INSTALL_OPENVOX_SCRIPT}

runcmd:
  - set -e
  - export DEBIAN_FRONTEND=noninteractive
  - systemctl restart systemd-networkd
  - /lib/systemd/systemd-networkd-wait-online --timeout=120
  - sleep 5

  - apt-get update && apt-get -y upgrade && apt-get -y autoremove
  - apt-get install -y apt-transport-https qemu-guest-agent

  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent

  - bash /usr/local/bin/install-openvox.sh

  # Cloned guests configure their enrollment identity before enabling Puppet.
  - systemctl unmask --runtime puppet.service
  - systemctl disable --now puppet.service

  # Clean APT
  - apt-get autoremove -y
  - apt-get clean
