#cloud-config
hostname: ${NEW_VM_NAME}
fqdn: ${VM_FQDN}
prefer_fqdn_over_hostname: false
manage_etc_hosts: true
output: {all: '| tee -a /var/log/cloud-init-output.log /dev/ttyS0'}
bootcmd:
  - cloud-init-per instance puppet-enrollment-mask systemctl mask --runtime --now puppet.service

packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - htop
  - jq
  - tree
  - vim
  - qemu-guest-agent

write_files:
  - path: /usr/local/bin/configure-puppet.sh
    permissions: '0755'
    content: |
${CONFIGURE_PUPPET_SCRIPT}

  - path: /etc/cloud/cloud.cfg.d/99-hostname.cfg
    permissions: '0644'
    content: |
      hostname: ${NEW_VM_NAME}
      fqdn: ${VM_FQDN}
      prefer_fqdn_over_hostname: false
      manage_etc_hosts: true

  - path: /usr/local/bin/install-openvox.sh
    permissions: '0755'
    content: |
${INSTALL_OPENVOX_SCRIPT}

  - path: /etc/puppetlabs/puppet/ssl/certs/ca.pem
    permissions: '0644'
    content: |
${OPENVOX_CA_BUNDLE}

  - path: /etc/docker/daemon.json
    content: |
      {
        "default-address-pools" : [
          {
            "base" : "172.17.0.0/12",
            "size" : 20
          },
          {
            "base" : "${IPV6_POOL}",
            "size" : 64
          }
        ],
        "experimental": true,
        "fixed-cidr-v6": "${IPV6_FIXED}",
        "ipv6": true,
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        },
        "userns-remap": "${DOCKER_USERNS_REMAP}",
        "userland-proxy": false
      }

runcmd:
  - set -e
  - export DEBIAN_FRONTEND=noninteractive
  - systemctl restart systemd-networkd
  - /lib/systemd/systemd-networkd-wait-online --timeout=60
  - sleep 5
  - mkdir -p /run/sshd && chmod 755 /run/sshd

  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc

  - |
    echo "deb [signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo \"${UBUNTU_CODENAME:-$VERSION_CODENAME}\") stable" > /etc/apt/sources.list.d/docker.list

  - wget -O - https://apt.releases.hashicorp.com/gpg | gpg --batch --yes --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(grep -oP '(?<=UBUNTU_CODENAME=).*' /etc/os-release || lsb_release -cs) main" | tee /etc/apt/sources.list.d/hashicorp.list

  - apt update
  - apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin vault
  - bash /usr/local/bin/install-openvox.sh

  - |
    /opt/puppetlabs/puppet/bin/ruby -ropenssl -e '
      certificates = File.read(ARGV.fetch(0)).scan(/-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----/m).map { |pem| OpenSSL::X509::Certificate.new(pem) }
      roots = certificates.select { |cert| cert.subject == cert.issuer && cert.verify(cert.public_key) && cert.extensions.any? { |extension| extension.oid == "basicConstraints" && extension.value.include?("CA:TRUE") } }
      abort "Authenticated bundle must contain exactly one root CA" unless roots.one?
      File.write(ARGV.fetch(1), roots.first.to_pem)
    ' /etc/puppetlabs/puppet/ssl/certs/ca.pem /usr/local/share/ca-certificates/atlas-infrastructure.crt
  - update-ca-certificates

  - mkdir -p /home/user/docker
  - ${PUPPET_ENROLLMENT_COMMAND}

  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - systemctl enable docker
  - systemctl start docker

  # FreeIPA enrollment sets the FQDN; restore the short OS hostname convention.
  - [hostnamectl, set-hostname, "${NEW_VM_NAME}"]

final_message: "Host ready. IPv6 configured with ${IPV6_FIXED}"
