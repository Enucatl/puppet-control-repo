# Vault
VAULT_ADDR=https://vault.home.arpa:8200
VAULT_CACERT=/etc/ssl/certs/ca-certificates.crt
VAULT_TOKEN=

# Native provisioning host: operator-authenticated public OpenVox CA bundle.
# Required by new Docker/desktop guests and native Proxmox enrollment.
OPENVOX_CA_CERT=/path/to/authenticated-openvox-chain.pem

# Enrolled native host identity allowed to import root CRLs into OpenVox.
OPENVOX_CRL_PUBLISHER_CERTNAME=docker.home.arpa

# Compiler-only CRL verification; infra Compose sets its own container path.
# VAULT_CRL=/path/to/current-vault-issuer-crls.pem

# FreeIPA
PASSWORD=

# Optional Proxmox template/Atlas base settings; no credentials needed by the base.
LOG_DIR=/var/log/openvox-provisioning
SNIPPET_STORAGE=snippets
TEMPLATE_ID=9001
# Existing agents keep their endpoint; new enrollment can select Atlas explicitly.
# PUPPET_SERVER=docker.home.arpa
