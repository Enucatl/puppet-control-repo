#!/bin/bash
set -euo pipefail

# === Neovim Install Script ===
# Rendered from Puppet EPP template
# Module: neovim | Class: neovim

TAG=""
URL=""

# Resolve version and download URL
<% if $version { -%>
# Installing pinned version: <%= $version %>
TAG="<%= $version %>"
URL="https://github.com/neovim/neovim/releases/download/${TAG}/<%= $asset_name %>"
<% } else { -%>
echo "🔍 Fetching latest Neovim release..."

# Use jq for all filtering to avoid SIGPIPE from grep|head
TAG=$(curl -sL https://api.github.com/repos/neovim/neovim/releases/latest \
      | jq -r '.tag_name // empty')

URL=$(curl -sL https://api.github.com/repos/neovim/neovim/releases/latest \
      | jq -r --arg asset "<%= $asset_name %>" '
          .assets[] 
          | select(.name == $asset) 
          | .browser_download_url 
          // empty' \
      | head -n1)

# Validate API response
if [[ -z "${TAG}" || -z "${URL}" || "${TAG}" == "null" ]]; then
  echo "❌ Failed to fetch release info from GitHub API" >&2
  exit 1
fi
<% } -%>

echo "📦 Installing Neovim ${TAG} to <%= $install_dir %>"

# Check if already installed at this version (idempotency)
if [ -f "<%= $marker_file %>" ] && [ "$(cat "<%= $marker_file %>" 2>/dev/null)" = "${TAG}" ]; then
  echo "✅ Neovim ${TAG} already installed. Skipping."
  exit 0
fi

# Download asset
ASSET_PATH="/tmp/<%= $asset_name %>"
echo "⬇️  Downloading: ${URL}"

if ! curl -sL --fail --connect-timeout 30 "${URL}" -o "${ASSET_PATH}"; then
  echo "❌ Download failed: ${URL}" >&2
  exit 1
fi

# Validate download
if [ ! -s "${ASSET_PATH}" ]; then
  echo "❌ Download failed: ${ASSET_PATH} is empty" >&2
  exit 1
fi

# Extract
echo "📦 Extracting..."
if ! tar xzf "${ASSET_PATH}" -C /tmp 2>/dev/null; then
  echo "❌ Extraction failed" >&2
  exit 1
fi

# Prepare install directories
echo "🔧 Installing to <%= $install_dir %>"
mkdir -p "$(dirname "<%= $install_bin %>")" \
         "$(dirname "<%= $install_lib %>")" \
         "$(dirname "<%= $install_share %>")"

# Clean old install
rm -rf "<%= $install_base %>"

# Copy files with error checking
cp -a /tmp/nvim-linux-x86_64/bin "<%= $install_bin %>" || {
  echo "❌ Failed to copy bin directory" >&2
  exit 1
}
cp -a /tmp/nvim-linux-x86_64/lib "<%= $install_lib %>" || {
  echo "❌ Failed to copy lib directory" >&2
  exit 1
}
cp -a /tmp/nvim-linux-x86_64/share "<%= $install_share %>" || {
  echo "❌ Failed to copy share directory" >&2
  exit 1
}

# Write version marker for idempotency
mkdir -p "$(dirname "<%= $marker_file %>")"
echo "${TAG}" > "<%= $marker_file %>"

echo "✨ Neovim ${TAG} installed successfully!"
echo "📍 Binary: <%= $install_bin %>/nvim"
