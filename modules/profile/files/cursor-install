#!/bin/sh
set -eu

os="${1:?missing OS}"
arch="${2:?missing architecture}"

version="$(/usr/local/sbin/cursor-latest-version)"

versions="$HOME/.local/share/cursor-agent/versions"
target="$versions/$version"
tmp="$versions/.${version}.$$"

url="https://downloads.cursor.com/lab/$version/$os/$arch/agent-cli-package.tar.gz"

mkdir -p "$versions" "$HOME/.local/bin"
rm -rf "$tmp"
mkdir "$tmp"

trap 'rm -rf "$tmp"' EXIT

curl -fsSL "$url" |
  tar --strip-components=1 -xzf - -C "$tmp"

test -x "$tmp/cursor-agent"

rm -rf "$target"
mv "$tmp" "$target"

ln -sfn "$target/cursor-agent" "$HOME/.local/bin/agent"
ln -sfn "$target/cursor-agent" "$HOME/.local/bin/cursor-agent"

trap - EXIT
