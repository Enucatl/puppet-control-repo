[Unit]
Description=Renew and verify Atlas Vault and FreeIPA transport certificates
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=OPENSSL_CONF=/opt/docker/puppet-control-repo/docker/openvox/openssl.cnf
ExecStart=/usr/bin/python3 /opt/docker/puppet-control-repo/proxmox/atlas-transport-renew.py renew
TimeoutStartSec=15min
