#!/usr/bin/env bash
set -euo pipefail

versions_dir="${1:?missing versions directory}"
[ -d "$versions_dir" ] || exit 0

versions="$(
  for version_dir in "$versions_dir"/*; do
    if [ -d "$version_dir" ] || [ -f "$version_dir" ]; then
      printf '%s\n' "${version_dir##*/}"
    fi
  done | sort -t. -k1,1nr -k2,2nr -k3,3nr
)"
[ -n "$versions" ] || exit 0

count=0
while IFS= read -r version; do
  count=$((count + 1))
  if [ "$count" -gt 2 ]; then
    rm -rf -- "$versions_dir/$version"
  fi
done <<< "$versions"
