#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
state_dir="$HOME/.cache/puppet/codex-ponytail"
marketplace_dir="$HOME/.local/share/codex/ponytail-marketplace"
catalog="$marketplace_dir/.agents/plugins/marketplace.json"
releases="$state_dir/releases.json"
checked_at="$state_dir/checked-at"
etag="$state_dir/etag"

mkdir -p "$state_dir" "$(dirname "$catalog")"
exec 9>"$state_dir/lock"
flock 9

# The user toolchain runs first and provides the Codex binary through nvm.
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
. "$NVM_DIR/nvm.sh"
nvm use default >/dev/null

now="$(date -u +%s)"
last_check="$(cat "$checked_at" 2>/dev/null || printf '0')"
[[ "$last_check" =~ ^[0-9]+$ ]] || last_check=0

if [ "$last_check" -eq 0 ] || [ "$now" -lt "$last_check" ] || [ "$((now - last_check))" -ge 86400 ]; then
  response="$(mktemp "$state_dir/releases.XXXXXX")"
  headers="$(mktemp "$state_dir/headers.XXXXXX")"
  trap 'rm -f "$response" "$headers"' EXIT

  request_headers=(-H 'Accept: application/vnd.github+json')
  if [ -s "$etag" ]; then
    request_headers+=(-H "If-None-Match: $(cat "$etag")")
  fi

  status="$(curl --silent --show-error --location --connect-timeout 3 --max-time 8 \
    "${request_headers[@]}" -D "$headers" -o "$response" -w '%{http_code}' \
    'https://api.github.com/repos/DietrichGebert/ponytail/releases?per_page=30')" || status=000

  if [ "$status" = 200 ] && jq -e 'type == "array"' "$response" >/dev/null; then
    mv "$response" "$releases"
    awk 'tolower($1) == "etag:" { gsub("\r", "", $2); value = $2 } END { if (value != "") print value }' "$headers" > "$etag"
    printf '%s\n' "$now" > "$checked_at"
  elif [ "$status" = 304 ] && [ -s "$releases" ]; then
    printf '%s\n' "$now" > "$checked_at"
  else
    echo "warning: Ponytail release check failed (HTTP $status); using cached releases" >&2
    printf '%s\n' "$now" > "$checked_at"
  fi
  rm -f "$response" "$headers"
  trap - EXIT
fi

if [ ! -s "$releases" ]; then
  echo 'Ponytail release metadata is unavailable' >&2
  exit 1
fi

cutoff="$(date -u -d '3 days ago' +%Y-%m-%dT%H:%M:%SZ)"
tag="$(jq -r --arg cutoff "$cutoff" '
  [.[] | select(.draft == false and .prerelease == false)
       | select(.tag_name | test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))
       | select((.published_at | type) == "string" and .published_at <= $cutoff)]
  | sort_by(.published_at) | last | .tag_name // empty
' "$releases")"

if [ -z "$tag" ]; then
  echo 'No Ponytail release has passed the three-day delay yet' >&2
  exit 0
fi

desired_version="${tag#v}"
new_catalog="$(mktemp "$(dirname "$catalog")/marketplace.XXXXXX")"
trap 'rm -f "$new_catalog"' EXIT
jq -n --arg tag "$tag" '{
  name: "ponytail",
  interface: { displayName: "Ponytail" },
  plugins: [{
    name: "ponytail",
    source: { source: "url", url: "https://github.com/DietrichGebert/ponytail.git", ref: $tag },
    policy: { installation: "AVAILABLE", authentication: "ON_INSTALL" },
    category: "Productivity"
  }]
}' > "$new_catalog"
if ! cmp -s "$new_catalog" "$catalog"; then
  mv "$new_catalog" "$catalog"
fi
rm -f "$new_catalog"
trap - EXIT

current="$(codex plugin list --marketplace ponytail --json)"
installed_version="$(jq -r '.installed[]? | select(.pluginId == "ponytail@ponytail") | .version // empty' <<< "$current")"
enabled="$(jq -r '.installed[]? | select(.pluginId == "ponytail@ponytail") | .enabled' <<< "$current")"
if [ "$installed_version" = "$desired_version" ] && [ "$enabled" = true ]; then
  exit 0
fi

echo "syncing Ponytail: installed=${installed_version:-none}, desired=$desired_version, enabled=${enabled:-false}"
codex plugin add ponytail@ponytail --json >/dev/null
current="$(codex plugin list --marketplace ponytail --json)"
installed_version="$(jq -r '.installed[]? | select(.pluginId == "ponytail@ponytail") | .version // empty' <<< "$current")"
enabled="$(jq -r '.installed[]? | select(.pluginId == "ponytail@ponytail") | .enabled' <<< "$current")"
if [ "$installed_version" != "$desired_version" ] || [ "$enabled" != true ]; then
  echo "Ponytail did not reach the requested version and enabled state: version=${installed_version:-none}, enabled=${enabled:-false}" >&2
  exit 1
fi
