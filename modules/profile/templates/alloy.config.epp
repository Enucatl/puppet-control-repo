<%- | String $loki_url, Boolean $enable_docker, String $extra_config | -%>
// 1. Output: Remote Loki
loki.write "remote_loki" {
  endpoint {
    url = "<%= $loki_url %>"
    
    // MEMORY OPTIMIZATION:
    batch_wait = "1s"
    batch_size = "512KB"
  }

  wal {
    enabled = true
    max_segment_age = "1h" 
  }
}

// 2. Input: Systemd Journal
loki.relabel "journal" {
  forward_to = [loki.write.remote_loki.receiver]

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex = "(.+)"
    target_label = "service_name"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    regex = "(.+)"
    target_label = "journal_priority"
  }
}

loki.source.journal "read_journal" {
  max_age = "1h" 
  labels  = {
    job  = "systemd-journal",
    host = "<%= $trusted['certname'] %>",
  }
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.relabel.journal.receiver]
}

// 3. Input: /var/log Files
local.file_match "varlogs_files" {
  path_targets = [{
    __path__         = "/var/log/*.log",
    __path_exclude__ = "/var/log/ipaclient-install.log",
    job              = "varlogs",
    host             = "<%= $trusted['certname'] %>",
  }]
}

loki.source.file "varlogs_scrape" {
  targets    = local.file_match.varlogs_files.targets
  forward_to = [loki.write.remote_loki.receiver]
}

<% if $enable_docker { -%>
// ==========================================
// DOCKER LOG SCRAPING
// ==========================================
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "60s"
}

discovery.relabel "docker_relabel" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project", "__meta_docker_container_label_com_docker_compose_service"]
    separator = "/"
    regex = "(.+)/(.+)"
    replacement = "$1/$2"
    action = "replace"
    target_label = "service_name"
  }
  rule {
    source_labels = ["service_name", "__meta_docker_container_name"]
    separator = ";"
    regex = ";/(.*)"
    replacement = "$1"
    action = "replace"
    target_label = "service_name"
  }
  rule {
    target_label = "host"
    replacement = "<%= $trusted['certname'] %>"
  }
  rule {
    target_label = "job"
    replacement = "docker"
  }
  // Drop Loki logs here to avoid re-ingesting the Loki container through this Docker scrape path and creating a loop.
  rule {
    source_labels = ["service_name"]
    regex = "grafana-loki-loki-1" 
    action = "drop"
  }
  // GoFlow2 is scraped by a dedicated pipeline for GeoIP enrichment, so exclude it here to avoid duplicate ingestion and feedback loops.
  rule {
    source_labels = ["service_name"]
    regex = ".*goflow2.*"
    action = "drop"
  }
}

loki.process "docker_logs" {
  forward_to = [loki.process.barbero_caddy.receiver]

  // i2pd emits ANSI-colored severity names. Normalize and parse only this
  // container so other Docker log bodies remain unchanged.
  stage.match {
    selector = "{service_name=\"tor-i2pd-i2pd-1\"}"

    stage.decolorize {}

    stage.regex {
      expression         = "^\\[[^]]+\\]@[0-9]+/(?P<level>debug|info|warn|error) - "
      labels_from_groups = true
    }
  }
}

loki.process "barbero_caddy" {
  forward_to = [loki.write.remote_loki.receiver]

  stage.match {
    selector = "{service_name=\"barbero-scripts-caddy-1\"}"

    stage.json {
      expressions = {
        trusted_client_ip = "request.headers.\"Cf-Connecting-Ip\"[0]",
      }
    }

    stage.regex {
      source = "trusted_client_ip"
      expression = "^(?P<trusted_client_geoip_skip>(?:10\\.|127\\.|169\\.254\\.|192\\.168\\.|172\\.(?:1[6-9]|2[0-9]|3[0-1])\\.|100\\.(?:6[4-9]|7[0-9]|8[0-9]|9[0-9]|1[0-1][0-9]|12[0-7])\\.|22[4-9]\\.|23[0-9]\\.|0\\.0\\.0\\.0$|::1$|fe80:|fc|fd|ff|2001:db8:|__LOCAL_IPV6_PREFIX__:))"
    }

    stage.template {
      source = "trusted_client_geoip_run"
      template = "{{ if .trusted_client_geoip_skip }}false{{ else }}true{{ end }}"
    }

    stage.labels {
      values = {
        trusted_client_geoip_run = "",
      }
    }

    stage.match {
      selector = "{trusted_client_geoip_run=\"true\"}"

      stage.geoip {
        source  = "trusted_client_ip"
        db      = "/var/lib/geoip/GeoLite2-City.mmdb"
        db_type = "city"
      }

      stage.labels {
        values = {
          country_code = "geoip_country_code",
        }
      }

      stage.structured_metadata {
        values = {
          geoip_country_code      = "geoip_country_code",
          geoip_country_name      = "geoip_country_name",
          geoip_city              = "geoip_city_name",
          geoip_continent         = "geoip_continent_name",
          geoip_subdivision       = "geoip_subdivision_name",
          geoip_timezone           = "geoip_timezone",
          geoip_postal_code        = "geoip_postal_code",
          geoip_latitude           = "geoip_location_latitude",
          geoip_longitude          = "geoip_location_longitude",
        }
      }
    }

    stage.label_drop {
      values = ["trusted_client_geoip_run"]
    }
  }
}

loki.source.docker "docker_logs" {
  targets = discovery.relabel.docker_relabel.output
  forward_to = [loki.process.docker_logs.receiver]
  host = "unix:///var/run/docker.sock"
  labels = {"app" = "docker"}
}
<% } -%>

<% if $extra_config != '' { -%>
<%= $extra_config %>
<% } -%>
