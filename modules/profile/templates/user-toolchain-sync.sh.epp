#!/usr/bin/env bash
set -euo pipefail

export HOME='<%= $home %>'
export USER='<%= $username %>'
export LOGNAME='<%= $username %>'
export PROFILE=/dev/null
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin"

mkdir -p "$HOME/.cache/puppet" "$HOME/.local/bin"

lock_file="$HOME/.cache/puppet/user-toolchain.lock"
exec 9>"$lock_file"
flock 9

log() {
  printf '%s user-toolchain: %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$*"
}

latest_nvm_tag() {
  curl -sL https://api.github.com/repos/nvm-sh/nvm/releases/latest \
    | jq -r '.tag_name // empty'
}

npm_installed_version() {
  local package_name="$1"

  npm list -g --depth=0 --json "$package_name" 2>/dev/null \
    | node -e 'const fs = require("fs"); const pkg = process.argv[1]; const data = JSON.parse(fs.readFileSync(0, "utf8")); const dep = data.dependencies && data.dependencies[pkg]; process.stdout.write((dep && dep.version) || "");' "$package_name"
}

npm_remote_version() {
  local package_name="$1"
  local before_date="${2:-}"

  if [ -n "$before_date" ]; then
    npm view "$package_name" version --json --before="$before_date" 2>/dev/null | tr -d '"'
    return
  fi

  npm view "$package_name" version --json 2>/dev/null | tr -d '"'
}

install_uv() {
  log 'checking uv'
  if [ ! -x "$HOME/.local/bin/uv" ]; then
    log 'installing uv'
    curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_INSTALL_DIR="$HOME/.local/bin" UV_NO_MODIFY_PATH=1 sh
    log 'installed uv'
    return
  fi

  uv_update_check="$("$HOME/.local/bin/uv" self update --dry-run 2>&1 || true)"
  if printf '%s\n' "$uv_update_check" | grep -Eq 'already on version|latest version'; then
    log 'uv is already up to date'
    return
  fi

  log "updating uv based on check output: ${uv_update_check}"
  "$HOME/.local/bin/uv" self update
  log 'updated uv'
}

install_rustup() {
  log 'checking rustup'
  if [ ! -x "$HOME/.cargo/bin/rustup" ]; then
    log 'installing rustup'
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --default-toolchain '<%= $rust_toolchain %>'
    log 'installed rustup'
    return
  fi

  rustup_check_status=0
  "$HOME/.cargo/bin/rustup" check --no-self-update >/dev/null 2>&1 || rustup_check_status=$?

  if [ "$rustup_check_status" -eq 0 ]; then
    log 'rustup toolchains are already up to date'
    "$HOME/.cargo/bin/rustup" default '<%= $rust_toolchain %>'
    return
  fi

  if [ "$rustup_check_status" -eq 100 ]; then
    log "updating rustup and rust toolchain: check reported available updates for <%= $rust_toolchain %>"
    "$HOME/.cargo/bin/rustup" self update
    "$HOME/.cargo/bin/rustup" update '<%= $rust_toolchain %>'
    "$HOME/.cargo/bin/rustup" default '<%= $rust_toolchain %>'
    log 'updated rustup and rust toolchain'
    return
  fi

  log "rustup check failed with exit status ${rustup_check_status}; running full update path"
  "$HOME/.cargo/bin/rustup" self update
  "$HOME/.cargo/bin/rustup" update '<%= $rust_toolchain %>'
  "$HOME/.cargo/bin/rustup" default '<%= $rust_toolchain %>'
}

install_nvm() {
  log 'checking nvm'
  export NVM_DIR="$HOME/.nvm"

  if [ ! -d "$NVM_DIR/.git" ]; then
    log 'installing nvm'
    rm -rf "$NVM_DIR"
    git clone https://github.com/nvm-sh/nvm.git "$NVM_DIR"
    log 'installed nvm'
  fi

  current_tag="$(git -C "$NVM_DIR" tag -l 'v*' --sort=-v:refname | head -n 1)"
  latest_tag="$(latest_nvm_tag)"
  if [ -n "$latest_tag" ] && [ "$latest_tag" != "$current_tag" ]; then
    log "updating nvm from ${current_tag:-unknown} to ${latest_tag}"
    git -C "$NVM_DIR" fetch --tags --prune https://github.com/nvm-sh/nvm.git
    git -C "$NVM_DIR" checkout --force --quiet "$latest_tag"
    log 'updated nvm'
  else
    log "nvm is already up to date at ${current_tag:-unknown}"
  fi

  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh"

  npm_before_date() {
    if date -v-"<%= $npm_before_days %>"d +%Y-%m-%d >/dev/null 2>&1; then
      date -v-"<%= $npm_before_days %>"d +%Y-%m-%d
      return
    fi

    date -d "<%= $npm_before_days %> days ago" +%Y-%m-%d
  }

  npm_before_cutoff="$(npm_before_date)"

  cat > "$NVM_DIR/default-packages" <<'NVM_DEFAULT_PACKAGES'
<%- $npm_globals.each |$package| { -%>
<%= $package %>
<%- } -%>
NVM_DEFAULT_PACKAGES

  installed_node_version="$(nvm version '<%= $node_version %>')"
  remote_node_version="$(nvm version-remote '<%= $node_version %>')"
  if [ "$installed_node_version" != "$remote_node_version" ]; then
    log "updating node: installed=${installed_node_version:-unknown} published=${remote_node_version:-unknown}"
    nvm install '<%= $node_version %>'
    log 'updated node'
  else
    log "node is already current: installed=${installed_node_version:-unknown} published=${remote_node_version:-unknown}"
  fi

  nvm alias default '<%= $node_version %>'
  nvm use default

<% if $npm_ignore_scripts { -%>
  npm config set --location=user ignore-scripts true
<% } -%>

  installed_npm_version="$(npm --version)"
  remote_npm_version="$(npm_remote_version npm)"
  if [ -z "$remote_npm_version" ] || [ "$installed_npm_version" != "$remote_npm_version" ]; then
    log "updating npm: installed=${installed_npm_version:-unknown} published=${remote_npm_version:-unknown}"
    if ! nvm install-latest-npm; then
      echo 'warning: npm@latest could not be installed for the active Node version' >&2
    fi
    log 'updated npm'
  else
    log "npm is already current: installed=${installed_npm_version:-unknown} published=${remote_npm_version:-unknown}"
  fi

<%- $npm_globals.each |$package| { -%>
  installed_package_version="$(npm_installed_version '<%= $package %>')"
  remote_package_version="$(npm_remote_version '<%= $package %>' "$npm_before_cutoff")"
  if [ -z "$installed_package_version" ] || [ -z "$remote_package_version" ] || [ "$installed_package_version" != "$remote_package_version" ]; then
    log "updating npm package <%= $package %>: installed=${installed_package_version:-unknown} published=${remote_package_version:-unknown}"
    npm install -g --before="$npm_before_cutoff" '<%= $package %>@latest'
    log "updated npm package <%= $package %>"
  else
    log "npm package <%= $package %> is already current: installed=${installed_package_version:-unknown} published=${remote_package_version:-unknown}"
  fi
<%- } -%>
}

<% if $manage_uv { -%>
install_uv
<% } -%>
<% if $manage_rustup { -%>
install_rustup
<% } -%>
<% if $manage_nvm { -%>
install_nvm
<% } -%>

log 'user toolchain sync complete'
