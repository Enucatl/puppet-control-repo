#!/bin/bash
# Vault auto-login via PAM; pam_exec supplies a NUL-terminated password on stdin.

export VAULT_ADDR="https://vault.home.arpa:8200"
export VAULT_CACERT="/etc/ssl/certs/ca-certificates.crt"
export VAULT_CLIENT_TIMEOUT="5s"

[ "$PAM_TYPE" = "auth" ] || exit 0
case "$PAM_SERVICE" in
  sshd|login|gdm-password|lightdm|sddm) ;;
  *) exit 0 ;;
esac
[ -n "$PAM_USER" ] || exit 0

# Use the user's token helper and permissions, and keep the password out of argv.
runuser -u "$PAM_USER" -- /bin/bash -c '
  unset VAULT_TOKEN VAULT_LDAP_PASSWORD
  IFS= read -r -d "" VAULT_LDAP_PASSWORD || true
  [ -n "$VAULT_LDAP_PASSWORD" ] || exit 0
  vault token lookup >/dev/null 2>&1 && exit 0
  export VAULT_LDAP_PASSWORD
  exec vault login -method=ldap -no-print username="$1"
' vault-pam-login "$PAM_USER" >/dev/null 2>&1 || true
