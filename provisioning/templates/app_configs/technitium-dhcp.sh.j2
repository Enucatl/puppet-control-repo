# Scope creation enables DHCP: this section must only run with --network none.
[[ $(podman inspect --format '{% raw %}{{.HostConfig.NetworkMode}}{% endraw %}' "$container") == none ]]
{% for scope in technitium_dhcp_scopes %}
api dhcp/scopes/set name={{ scope.name }} \
    startingAddress={{ scope.router | ansible.utils.ipaddr('address') }} endingAddress={{ scope.end }} subnetMask=255.255.255.0 \
    'exclusions={{ scope.router | ansible.utils.ipaddr("address") }}|{{ scope.start | ansible.utils.ipmath(-1) }}' \
    leaseTimeDays={{ scope.lease_hours // 24 }} leaseTimeHours={{ scope.lease_hours % 24 }} leaseTimeMinutes=0 \
    pingCheckEnabled=true \
    domainName={{ scope.domain | default('') }} dnsUpdates={{ (scope.domain is defined) | lower }} \
    dnsOverwriteForDynamicLease=false dnsTtl=300 \
    routerAddress={{ scope.router | ansible.utils.ipaddr('address') }} \
    useThisDnsServer=false dnsServers={{ vyos_lan_ip | ansible.utils.ipaddr('address') }} \
    serverAddress={{ scope.boot_server | default('') }} bootFileName={{ scope.boot_file | default('') }} \
    {{ ('reservedLeases=' ~ scope.reserved_leases | join('|')) | quote }} >/dev/null
api dhcp/scopes/disable name={{ scope.name }} >/dev/null
{% endfor %}
api dhcp/scopes/list | jq -e 'all(.response.scopes[]; .enabled == false)' >/dev/null
