# This is a preparation baseline; cutover needs a fresh lease snapshot after DHCP stops.
install -d -m 0700 /config/backups/technitium
backup=$(mktemp -d "/config/backups/technitium/prepare-$(date -u +%Y%m%dT%H%M%SZ)-XXXXXX")
tar --directory=/ -czf "$backup/production-configs.tgz" \
    config/config.boot \
    {{ (adguard_data_path ~ '/conf').lstrip('/') | quote }} \
    {{ (dnsmasq_data_path ~ '/conf').lstrip('/') | quote }}
/opt/vyatta/bin/vyatta-op-cmd-wrapper show configuration commands > "$backup/running-config.commands"
cp {{ (dnsmasq_data_path ~ '/leases/dnsmasq.leases') | quote }} "$backup/dnsmasq.leases"
sha256sum /config/config.boot \
    {{ (adguard_data_path ~ '/conf/AdGuardHome.yaml') | quote }} \
    {{ (dnsmasq_data_path ~ '/conf/dnsmasq.conf') | quote }} > "$backup/production.sha256"
container_format='{% raw %}{{.Name}} {{.Id}} {{.State.StartedAt}}{% endraw %}'
podman inspect --format "$container_format" adguard dnsmasq technitium alloy > "$backup/containers.txt"
