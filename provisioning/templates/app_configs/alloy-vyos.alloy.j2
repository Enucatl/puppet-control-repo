// Alloy configuration for VyOS router.
// Managed by Ansible (router-config.yml). Do not edit manually.
//
// Sources:
//   - VyOS syslog       → host /var/log              mounted at /var/log/host
//   - Suricata EVE JSON → host /var/log/suricata/     mounted at /var/log/suricata
//   - Suricata stats    → host /var/log/suricata/     mounted at /var/log/suricata
//   - AdGuard querylog  → host adguard work dir       mounted at /var/adguard/work
//   - dnsmasq DHCP log  → host dnsmasq log dir        mounted at /var/dnsmasq/log

// ============================================================
// OUTPUT
// ============================================================

loki.write "remote_loki" {
  endpoint {
    url = "{{ loki_url }}"

    // VyOS is not a FreeIPA client so its container trust store does not
    // include the internal CA. Safe to skip on a non-routable address.
    tls_config {
      insecure_skip_verify = true
    }

    batch_wait = "1s"
    batch_size = "512KB"

    // Backoff settings to prevent log storms during network outages.
    // Exponential backoff increases retry interval from 30s to 5m max.
    min_backoff_period = "30s"
    max_backoff_period = "5m"
  }

  wal {
    enabled         = true
    max_segment_age = "1h"
  }
}

// ============================================================
// VyOS system logs
// Host /var/log is mounted read-only at /var/log/host to avoid
// shadowing the container's own /var/log directory.
// ============================================================

local.file_match "vyos_syslog" {
  path_targets = [
    {
      // Main syslog — no .log extension on VyOS/Debian
      __path__ = "/var/log/host/messages",
      job      = "vyos-syslog",
      host     = "router.{{ dhcp_domain }}",
    },
    {
      // auth, daemon, kern, etc.
      __path__ = "/var/log/host/*.log",
      job      = "vyos-syslog",
      host     = "router.{{ dhcp_domain }}",
    },
  ]
}

loki.source.file "vyos_syslog" {
  targets    = local.file_match.vyos_syslog.targets
  forward_to = [loki.write.remote_loki.receiver]
}

// ============================================================
// Suricata EVE JSON
// ============================================================

local.file_match "suricata_eve" {
  path_targets = [{
    __path__ = "/var/log/suricata/eve.json",
    job      = "suricata",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "suricata_eve" {
  targets    = local.file_match.suricata_eve.targets
  forward_to = [loki.process.label_eve.receiver]
}

// Promote event_type as a label for efficient stream filtering in Grafana.
// IP addresses, ports, and signatures are intentionally left in the log
// line body — query them via LogQL's | json parser to avoid high cardinality.
loki.process "label_eve" {
  stage.json {
    expressions = {
      event_type = "event_type",
    }
  }

  stage.labels {
    values = {
      event_type = null,
    }
  }

  forward_to = [loki.write.remote_loki.receiver]
}

// ============================================================
// Suricata performance stats
// Plain text; one stats block per interval. Useful for catching
// ring buffer drops (capture.kernel_drops counter).
// ============================================================

local.file_match "suricata_stats" {
  path_targets = [{
    __path__ = "/var/log/suricata/stats.log",
    job      = "suricata-stats",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "suricata_stats" {
  targets    = local.file_match.suricata_stats.targets
  forward_to = [loki.write.remote_loki.receiver]
}

// ============================================================
// AdGuard Home query log
// Work dir mounted read-only at /var/adguard/work.
// dir_path in AdGuardHome.yaml is set to /opt/adguardhome/work
// so the file lands at querylog.json in that directory.
// ============================================================

local.file_match "adguard_querylog" {
  path_targets = [{
    __path__ = "/var/adguard/work/querylog.json",
    job      = "adguard",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "adguard_querylog" {
  targets    = local.file_match.adguard_querylog.targets
  forward_to = [loki.process.label_adguard.receiver]
}

// Promote Result.IsFiltered as a label (true/false) so blocked queries
// are a distinct stream. Domain (QH), client IP, and query type are left
// in the log line body for LogQL json parsing.
loki.process "label_adguard" {
  stage.json {
    expressions = {
      filtered = "Result.IsFiltered",
    }
  }

  stage.labels {
    values = {
      filtered = null,
    }
  }

  forward_to = [loki.write.remote_loki.receiver]
}

// ============================================================
// dnsmasq DHCP log
// Log dir mounted read-only at /var/dnsmasq/log.
// dnsmasq.conf sets log-facility=/var/log/dnsmasq/dnsmasq.log
// inside the container, backed by this volume on the host.
// ============================================================

local.file_match "dnsmasq_dhcp" {
  path_targets = [{
    __path__ = "/var/dnsmasq/log/dnsmasq.log",
    job      = "dnsmasq",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "dnsmasq_dhcp" {
  targets    = local.file_match.dnsmasq_dhcp.targets
  forward_to = [loki.write.remote_loki.receiver]
}
