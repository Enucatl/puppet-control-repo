// Alloy configuration for VyOS router.
// Managed by Ansible (router-config.yml). Do not edit manually.
//
// Sources:
//   - VyOS syslog       → host /var/log              mounted at /var/log/host
//   - Suricata EVE JSON → central Alloy receiver      via HTTP push
//   - Suricata updater  → host /config/suricata/      mounted at /var/lib/suricata-config

// ============================================================
// OUTPUT
// ============================================================

loki.write "remote_loki" {
  endpoint {
    url = "{{ loki_url }}"

    tls_config {
      ca_file = "/etc/ssl/certs/ca-certificates.crt"
    }

    batch_wait = "1s"
    batch_size = "512KB"

    // Backoff settings to prevent log storms during network outages.
    // Exponential backoff increases retry interval from 30s to 5m max.
    min_backoff_period = "30s"
    max_backoff_period = "5m"
  }

  wal {
    enabled         = true
    max_segment_age = "1h"
  }
}

loki.write "central_alloy" {
  endpoint {
    url = "{{ central_alloy_url }}"

    batch_wait = "1s"
    batch_size = "512KB"

    min_backoff_period = "30s"
    max_backoff_period = "5m"
  }

  wal {
    enabled         = true
    max_segment_age = "1h"
  }
}

// ============================================================
// VyOS system logs
// Host /var/log is mounted read-only at /var/log/host to avoid
// shadowing the container's own /var/log directory.
// ============================================================

local.file_match "vyos_syslog" {
  path_targets = [
    {
      __path__ = "/var/log/host/vyos-ndp/vyos-ndp.jsonl",
      job      = "vyos-ndp",
      host     = "router.{{ dhcp_domain }}",
    },
    {
      // Main syslog — no .log extension on VyOS/Debian
      __path__ = "/var/log/host/messages",
      job      = "vyos-syslog",
      host     = "router.{{ dhcp_domain }}",
    },
    {
      // auth, daemon, kern, etc.
      __path__ = "/var/log/host/*.log",
      job      = "vyos-syslog",
      host     = "router.{{ dhcp_domain }}",
    },
  ]
}

loki.source.file "vyos_syslog" {
  targets    = local.file_match.vyos_syslog.targets
  forward_to = [loki.write.remote_loki.receiver]
}

// ============================================================
// Suricata EVE JSON
// ============================================================

local.file_match "suricata_eve" {
  path_targets = [{
    __path__ = "/var/log/suricata/eve.json",
    job      = "suricata",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "suricata_eve" {
  targets    = local.file_match.suricata_eve.targets
  forward_to = [loki.write.central_alloy.receiver]
}

// ============================================================
// Suricata updater log
// ============================================================

local.file_match "suricata_update" {
  path_targets = [{
    __path__ = "/var/lib/suricata-config/update.log",
    job      = "suricata-update",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "suricata_update" {
  targets    = local.file_match.suricata_update.targets
  forward_to = [loki.write.remote_loki.receiver]
}

// ============================================================

{% if technitium_active | default(false) %}
// Native query and DHCP messages; retain client/name fields in the log body.
local.file_match "technitium" {
  path_targets = [{
    __path__ = "/var/log/technitium/*.log",
    job      = "technitium",
    host     = "router.{{ dhcp_domain }}",
  }]
}

loki.source.file "technitium" {
  targets    = local.file_match.technitium.targets
  forward_to = [loki.write.central_alloy.receiver]
}
{% endif %}
