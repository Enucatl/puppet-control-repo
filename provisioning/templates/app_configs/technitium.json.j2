{{ {
  'data_path': technitium_data_path,
  'domain': dhcp_domain,
  'intranet': technitium_intranet_domain,
  'reverse_zones': technitium_reverse_zones,
  'hosts': technitium_dns_hosts,
  'scopes': technitium_dhcp_scopes,
  'dns': vyos_lan_ip | ansible.utils.ipaddr('address'),
  'local_query_acl': technitium_local_query_acl,
  'settings': {
    'dnsServerLocalEndPoints': '127.0.0.1:53,[::1]:53,' ~ (vyos_lan_ip | ansible.utils.ipaddr('address')) ~ ':53,[' ~ ula_prefix ~ '::1]:53',
    'webServiceLocalAddresses': '127.0.0.1,[::1]',
    'webServiceHttpPort': 5380,
    'ipv6Mode': 'Enabled',
    'dnssecValidation': true,
    'eDnsClientSubnet': false,
    'recursion': 'UseSpecifiedNetworkACL',
    'recursionNetworkACL': technitium_recursion_acl | join(','),
    'forwarders': '9.9.9.10,149.112.112.10,[2620:fe::10],[2620:fe::fe:10]',
    'forwarderProtocol': 'Udp',
    'concurrentForwarding': true,
    'qpmPrefixLimitsIPv4': '32|6000|0',
    'qpmPrefixLimitsIPv6': '56|6000|0',
    'enableBlocking': true,
    'blockingType': 'AnyAddress',
    'blockingAnswerTtl': 10,
    'blockListUrls': 'https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt',
    'blockListUpdateIntervalHours': 24,
    'serveStale': false,
    'cacheMinimumRecordTtl': 0,
    'logQueries': true,
    'logFolder': '/etc/dns/logs',
    'maxLogFileDays': 1,
    'maxStatFileDays': 1
  }
} | to_nice_json }}
