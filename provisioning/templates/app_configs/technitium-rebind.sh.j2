#!/bin/bash
set -euo pipefail
umask 077
data={{ (technitium_data_path ~ '-candidate') | quote }}
exec 9>/run/lock/technitium-cutover.lock
flock -n 9 || exit 0
[[ -f "$data/cutover-active" ]] || exit 0
systemctl is-active --quiet vyos-container-technitium.service || exit 0
container=technitium
{% include 'technitium-api.sh.j2' %}

trap 'api user/logout >/dev/null || true' EXIT
interfaces=$(ip -j -4 address show up)
for scope in {{ technitium_dhcp_scopes | map(attribute='name') | join(' ') }}; do
    pending="$data/rebind-$scope.pending"
    # Complete an interrupted rebind before considering another scope.
    if [[ -f "$pending" ]]; then
        api dhcp/scopes/enable "name=$scope" >/dev/null
        rm "$pending"
    fi
    scopes=$(api dhcp/scopes/list)
    address=$(jq -r --arg scope "$scope" '.response.scopes[] | select(.name == $scope and .enabled and .interfaceAddress == "0.0.0.0") | .startingAddress' <<< "$scopes")
    [[ -n "$address" ]] || continue
    # Managed scopes start at their router IP; dynamic pool exclusions stay intact.
    if jq -e --arg address "$address" 'any(.[]; .operstate == "UP" and any(.addr_info[]; .local == $address))' <<< "$interfaces" >/dev/null; then
        touch "$pending"
        api dhcp/scopes/disable "name=$scope" >/dev/null
        api dhcp/scopes/enable "name=$scope" >/dev/null
        rm "$pending"
        logger -t technitium-rebind "Rebound DHCP scope $scope to $address"
    fi
done
