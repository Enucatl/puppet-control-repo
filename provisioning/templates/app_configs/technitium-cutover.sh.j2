#!/bin/bash
set -Eeuo pipefail
umask 077
exec 9>/run/lock/technitium-cutover.lock
flock -n 9
migration_pid=$BASHPID
mode=${1:?usage: technitium-cutover.sh rehearse OR cutover OR rollback BACKUP}
data={{ (technitium_data_path ~ '-candidate') | quote }}
image={{ technitium_image | quote }}
container=technitium-migration
[[ -s "$data/admin-password" ]]
helper=/config/scripts/technitium-leases.py
scopes=/config/scripts/technitium-scopes.json
hosts=/config/scripts/technitium-hosts.json

start_isolated() {
    podman run --detach --name "$container" --network none --cap-add NET_RAW --memory 512m --cpus 0.5 \
        --volume "$data:/etc/dns" "$image" >/dev/null
}
stop_isolated() {
    podman stop --time 30 "$container" >/dev/null
    podman rm "$container" >/dev/null
}
wait_scopes() {
    local attempt
    for attempt in {1..30}; do
        if api dhcp/scopes/list | jq -e '[.response.scopes[].name] | contains({{ technitium_dhcp_scopes | map(attribute="name") | list | to_json }})' >/dev/null; then
            return 0
        fi
        sleep 1
    done
    echo 'DHCP scopes did not finish loading' >&2
    return 1
}
configure_vyos() {
    local commands=$1
    {
        echo '#!/bin/vbash'
        echo 'source /opt/vyatta/etc/functions/script-template'
        echo 'configure || exit 1'
        sed '/^[[:space:]]*$/d; s/$/ || exit 1/' "$commands"
        echo 'commit || exit 1'
        echo 'save || exit 1'
        echo 'exit'
    } > "$backup/apply.vbash"
    # VyOS configuration writes must use vyattacfg group ownership.
    local invocation
    printf -v invocation '%q %q' /bin/vbash "$backup/apply.vbash"
    sg vyattacfg -c "$invocation"
}

case "$mode" in
cutover|rehearse)
    [[ ! -e "$data/cutover-active" ]]
    [[ ! -e "$data/continuity.json" ]]
{% include 'technitium-snapshot.sh.j2' %}
    # Retain the complete candidate before any migration edits.
    tar -C "$data" -czf "$backup/candidate.tgz" .
    sed -n -E '/^set container name (adguard|dnsmasq|technitium|alloy) /p' "$backup/running-config.commands" > "$backup/restore-containers.commands"
    [[ -s "$backup/restore-containers.commands" ]]
    cp "$scopes" "$backup/scopes.json"
    cp "$hosts" "$backup/hosts.json"
    cp "$helper" "$backup/technitium-leases.py"
    echo "$backup" > "$data/migration-backup"
    # Until production listeners change, any failure can safely resume the old server.
    trap 'if [[ $BASHPID == "$migration_pid" ]]; then echo "Migration failed at line $LINENO; backup=$backup" >&2; trap - ERR; if podman container exists technitium-migration; then podman stop --time 30 technitium-migration || true; podman rm technitium-migration || true; fi; if [[ $mode == cutover ]]; then systemctl start vyos-container-dnsmasq.service; fi; fi' ERR
    # Stop DHCP before the final snapshot; no client lease may escape the merge.
    if [[ "$mode" == cutover ]]; then
        systemctl stop vyos-container-dnsmasq.service
    fi
    cp {{ (dnsmasq_data_path ~ '/leases/dnsmasq.leases') | quote }} "$backup/dnsmasq-final.leases"
    python3 "$helper" --scopes "$scopes" --hosts "$hosts" --dnsmasq "$backup/dnsmasq-final.leases" > "$backup/continuity.json"
    start_isolated
{% include 'technitium-api.sh.j2' %}

    wait_scopes
    api dhcp/scopes/list | jq -e 'all(.response.scopes[]; .enabled == false)' >/dev/null
    for scope in {{ technitium_dhcp_scopes | map(attribute='name') | join(' ') }}; do
        api dhcp/scopes/set "name=$scope" "reservedLeases=$(jq -er --arg scope "$scope" '.reserved_leases[$scope]' "$backup/continuity.json")" >/dev/null
        api dhcp/scopes/disable "name=$scope" >/dev/null
    done
    api settings/set 'dnsServerLocalEndPoints=127.0.0.1:53,[::1]:53,{{ vyos_lan_ip | ansible.utils.ipaddr("address") }}:53,[{{ ula_prefix }}::1]:53' >/dev/null
    reservations() {
        for scope in {{ technitium_dhcp_scopes | map(attribute='name') | join(' ') }}; do
            api dhcp/scopes/get "name=$scope" | jq -Sc '.response.reservedLeases | map(.hostName = (.hostName // "")) | sort_by(.hardwareAddress)' || return
        done
    }
    expected=$(reservations | tee "$backup/reservations-before.json" | sha256sum)
    api user/logout >/dev/null
    stop_isolated
    start_isolated
    wait_ready
    token=$(api user/login user=admin "pass=$(cat "$data/admin-password")" | jq -er .token)
    wait_scopes
    observed=$(reservations | tee "$backup/reservations-after.json" | sha256sum)
    [[ "$observed" == "$expected" ]]
    api dhcp/scopes/list | jq -e 'all(.response.scopes[]; .enabled == false)' >/dev/null
    api user/logout >/dev/null
    stop_isolated
    if [[ "$mode" == rehearse ]]; then
        sha256sum --check "$backup/production.sha256"
        podman inspect --format "$container_format" adguard dnsmasq technitium alloy | cmp - "$backup/containers.txt"
        echo "TECHNITIUM_REHEARSAL_COMPLETE backup=$backup"
        exit 0
    fi
    cp "$backup/continuity.json" "$data/continuity.json"
    # From here failures require the lease-aware rollback, never a blind restart.
    trap - ERR
    touch "$data/cutover-active"
    systemctl stop vyos-container-adguard.service vyos-container-technitium.service
    cat > "$backup/activate.commands" <<'COMMANDS'
delete container name adguard
delete container name dnsmasq
set container name technitium capability net-raw
set container name technitium volume config source {{ technitium_data_path }}-candidate
COMMANDS
    configure_vyos "$backup/activate.commands"
    container=technitium
    wait_ready
    token=$(api user/login user=admin "pass=$(cat "$data/admin-password")" | jq -er .token)
    wait_scopes
    for scope in {{ technitium_dhcp_scopes | map(attribute='name') | join(' ') }}; do
        api dhcp/scopes/enable "name=$scope" >/dev/null
    done
    api dhcp/scopes/list | jq -e '[.response.scopes[] | select(.enabled) | .name] | sort == ({{ technitium_dhcp_scopes | map(attribute="name") | list | to_json }} | sort)' >/dev/null
    api settings/forceUpdateBlockLists >/dev/null
    api user/logout >/dev/null
    echo "TECHNITIUM_CUTOVER_COMPLETE backup=$backup"
    ;;
rollback)
    backup=${2:?backup directory required}
    [[ "$backup" == /config/backups/technitium/prepare-* && -f "$backup/restore-containers.commands" ]]
    [[ -f "$data/cutover-active" ]]
    scopes="$backup/scopes.json"
    hosts="$backup/hosts.json"
    helper="$backup/technitium-leases.py"
    # Freeze DHCP first, then inspect saved leases with no network attached.
    if systemctl is-active --quiet vyos-container-technitium.service; then
        systemctl stop vyos-container-technitium.service
    fi
    start_isolated
{% include 'technitium-api.sh.j2' %}

    wait_scopes
    api dhcp/leases/list > "$backup/technitium-final-leases.json"
    for scope in {{ technitium_dhcp_scopes | map(attribute='name') | join(' ') }}; do
        api dhcp/scopes/disable "name=$scope" >/dev/null
    done
    python3 "$helper" --scopes "$scopes" --hosts "$hosts" --holds "$data/continuity.json" --technitium "$backup/technitium-final-leases.json" > "$backup/rollback-continuity.json"
    jq -r .dnsmasq "$backup/rollback-continuity.json" > "$backup/continuity.conf"
    api user/logout >/dev/null
    stop_isolated
    # Validate the full original config plus holds before either old server starts.
    mkdir -p "$backup/rollback-config"
    tar -xzf "$backup/production-configs.tgz" -C "$backup/rollback-config"
    cp "$backup/continuity.conf" "$backup/rollback-config/{{ dnsmasq_data_path.lstrip('/') }}/conf/continuity.conf"
    podman run --rm --network none --volume "$backup/rollback-config/{{ dnsmasq_data_path.lstrip('/') }}/conf:/etc/dnsmasq.d:ro" {{ dnsmasq_image }} --test
    cp -a {{ dnsmasq_data_path }}/conf "$backup/dnsmasq-conf-before-rollback"
    cp -a {{ adguard_data_path }}/conf "$backup/adguard-conf-before-rollback"
    cp -a "$backup/rollback-config/{{ dnsmasq_data_path.lstrip('/') }}/conf/." {{ dnsmasq_data_path }}/conf/
    cp -a "$backup/rollback-config/{{ adguard_data_path.lstrip('/') }}/conf/." {{ adguard_data_path }}/conf/
    cp -a "$backup/rollback-config/{{ alloy_data_path.lstrip('/') }}/conf/." {{ alloy_data_path }}/conf/
    # Partial activation may leave any subset of the original containers.
    /opt/vyatta/bin/vyatta-op-cmd-wrapper show configuration commands > "$backup/pre-rollback.commands"
    : > "$backup/remove-active.commands"
    for name in technitium adguard dnsmasq alloy; do
        if grep -q "^set container name $name " "$backup/pre-rollback.commands"; then
            echo "delete container name $name" >> "$backup/remove-active.commands"
        fi
    done
    configure_vyos "$backup/remove-active.commands"
    configure_vyos "$backup/restore-containers.commands"
    mv "$data/cutover-active" "$backup/cutover-active.retired"
    echo "TECHNITIUM_ROLLBACK_COMPLETE backup=$backup"
    ;;
*) echo 'Expected rehearse, cutover or rollback' >&2; exit 2 ;;
esac
