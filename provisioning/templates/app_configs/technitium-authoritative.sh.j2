# Own the local zones; the candidate must not depend on dnsmasq.
zones=$(api zones/list)
for zone in {{ dhcp_domain }} {{ technitium_intranet_domain }} {{ technitium_reverse_zones | join(' ') }}; do
    if ! jq -e --arg zone "$zone" '.response.zones[] | select(.name == $zone)' <<< "$zones" >/dev/null; then
        api zones/create "zone=$zone" type=Primary >/dev/null
    fi
    api zones/options/set "zone=$zone" queryAccess=UseSpecifiedNetworkACL \
        {{ ('queryAccessNetworkACL=' ~ technitium_local_query_acl | join(',')) | quote }} \
        zoneTransfer=Deny >/dev/null
done
api zones/records/add zone={{ technitium_intranet_domain }} domain={{ technitium_intranet_domain }} \
    type=DNAME dname={{ dhcp_domain }} ttl=300 overwrite=true >/dev/null
{% for host in technitium_dns_hosts %}
{% for record_type in ['A', 'AAAA'] %}
{% set addresses = (host.addresses | select('search', ':') | list) if record_type == 'AAAA' else (host.addresses | reject('search', ':') | list) %}
{% for address in addresses %}
api zones/records/add zone={{ dhcp_domain }} domain={{ host.name }}.{{ dhcp_domain }} \
    type={{ record_type }} ipAddress={{ address }} ttl=300 \
    ptr={{ host.ptr | default(false) | lower }} overwrite={{ loop.first | lower }} >/dev/null
{% if host.wildcard | default(false) %}
api zones/records/add zone={{ dhcp_domain }} 'domain=*.{{ host.name }}.{{ dhcp_domain }}' \
    type={{ record_type }} ipAddress={{ address }} ttl=300 overwrite={{ loop.first | lower }} >/dev/null
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
api zones/records/add zone={{ dhcp_domain }} domain=_apt_proxy._tcp.{{ dhcp_domain }} \
    type=SRV priority=0 weight=0 port=3142 target=apt-cacher-ng.{{ dhcp_domain }} \
    ttl=10 overwrite=true >/dev/null
