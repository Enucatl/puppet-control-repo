set container name technitium cpu-quota 0.5
set container name technitium memory 512
set container name technitium allow-host-networks
set container name technitium image {{ technitium_image }}
set container name technitium restart on-failure
set container name technitium volume config destination /etc/dns
set container name technitium volume config mode rw
set container name technitium volume config source {{ technitium_data_path }}
