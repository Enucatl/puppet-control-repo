{% include 'partials/technitium.j2' %}
set container name alloy cpu-quota 0.5
set container name alloy memory 512
set container name alloy allow-host-networks
set container name alloy log-driver none
set container name alloy environment GOMEMLIMIT value 256MiB
set container name alloy command 'run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data --disable-reporting --stability.level=experimental'
set container name alloy image {{ alloy_image }}
set container name alloy restart on-failure
set container name alloy volume alloy_technitium_logs destination /var/log/technitium
set container name alloy volume alloy_technitium_logs mode ro
set container name alloy volume alloy_technitium_logs source {{ technitium_data_path }}/logs
set container name alloy volume alloy_conf destination /etc/alloy
set container name alloy volume alloy_conf mode ro
set container name alloy volume alloy_conf source {{ alloy_data_path }}/conf
set container name alloy volume alloy_ca destination /etc/ssl/certs/ca-certificates.crt
set container name alloy volume alloy_ca mode ro
set container name alloy volume alloy_ca source {{ alloy_data_path }}/conf/ca-certificates.crt
set container name alloy volume alloy_data destination /var/lib/alloy/data
set container name alloy volume alloy_data mode rw
set container name alloy volume alloy_data source {{ alloy_data_path }}/data
set container name alloy volume alloy_suricata_logs destination /var/log/suricata
set container name alloy volume alloy_suricata_logs mode ro
set container name alloy volume alloy_suricata_logs source /var/log/suricata
set container name alloy volume alloy_suricata_config destination /var/lib/suricata-config
set container name alloy volume alloy_suricata_config mode ro
set container name alloy volume alloy_suricata_config source /config/suricata
set container name alloy volume alloy_vyos_logs destination /var/log/host
set container name alloy volume alloy_vyos_logs mode ro
set container name alloy volume alloy_vyos_logs source /var/log
