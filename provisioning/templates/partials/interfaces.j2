set interfaces ethernet eth0 hw-id '{{ eth0_mac }}'
set interfaces ethernet {{ lan_interface }} address {{ vyos_lan_ip }}
set interfaces ethernet {{ lan_interface }} description 'LAN - Wired Trusted'
set interfaces ethernet {{ lan_interface }} hw-id '{{ lan_mac }}'
set interfaces ethernet {{ lan_interface }} offload gro
set interfaces ethernet {{ lan_interface }} offload gso
set interfaces ethernet {{ lan_interface }} offload sg
set interfaces ethernet {{ lan_interface }} offload tso
set interfaces ethernet {{ lan_interface }} vif {{ trusted_wifi_vlan }} address {{ trusted_wifi_ip }}
set interfaces ethernet {{ lan_interface }} vif {{ trusted_wifi_vlan }} description 'Trusted WiFi'
set interfaces ethernet {{ lan_interface }} vif {{ iot_vlan }} address {{ iot_ip }}
set interfaces ethernet {{ lan_interface }} vif {{ iot_vlan }} description IoT
set interfaces ethernet {{ lan_interface }} vif {{ guest_vlan }} address {{ guest_ip }}
set interfaces ethernet {{ lan_interface }} vif {{ guest_vlan }} description Guest
set interfaces ethernet eth2 hw-id '{{ eth2_mac }}'
set interfaces ethernet {{ wan_interface }} address dhcp
set interfaces ethernet {{ wan_interface }} address dhcpv6
set interfaces ethernet {{ wan_interface }} description 'WAN - Init7 25G'
set interfaces ethernet {{ wan_interface }} hw-id '{{ wan_mac }}'
set interfaces ethernet {{ wan_interface }} dhcpv6-options no-release
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }} address 1
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }} sla-id 0
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }}.{{ trusted_wifi_vlan }} address 1
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }}.{{ trusted_wifi_vlan }} sla-id {{ trusted_wifi_vlan }}
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }}.{{ iot_vlan }} address 1
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }}.{{ iot_vlan }} sla-id {{ iot_vlan }}
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }}.{{ guest_vlan }} address 1
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 interface {{ lan_interface }}.{{ guest_vlan }} sla-id {{ guest_vlan }}
set interfaces ethernet {{ wan_interface }} dhcpv6-options pd 0 length 48
set interfaces ethernet {{ wan_interface }} ipv6 address autoconf
set interfaces ethernet {{ wan_interface }} offload gro
set interfaces ethernet {{ wan_interface }} offload gso
set interfaces ethernet {{ wan_interface }} offload hw-tc-offload
set interfaces ethernet {{ wan_interface }} offload sg
set interfaces ethernet {{ wan_interface }} offload tso
set interfaces loopback lo
{% for peer in wg_peers %}
set interfaces wireguard {{ wg_interface }} peer {{ peer.name }} public-key '{{ peer.pubkey }}'
set interfaces wireguard {{ wg_interface }} peer {{ peer.name }} allowed-ips {{ peer.ip }}
set interfaces wireguard {{ wg_interface }} peer {{ peer.name }} description '{{ peer.name }}'
set interfaces wireguard {{ wg_interface }} peer {{ peer.name }} persistent-keepalive 15
{% endfor %}
set interfaces wireguard {{ wg_interface }} address {{ wg_subnet }}
set interfaces wireguard {{ wg_interface }} port {{ wg_port }}
set interfaces wireguard {{ wg_interface }} private-key '{{ wg_server_private_key }}'
